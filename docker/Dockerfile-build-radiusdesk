# Base PHP FPM 8.2 construite localement (Ubuntu 22.04 + PPA ondrej/php)
FROM hasinadirj/php:8.2-fpm

# Arguments we can take
ARG radiusdesk_volume

## Install all software required

# Installer les services nécessaires (Nginx, Supervisor, FreeRADIUS, etc.)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        nginx \
        supervisor \
        cron \
        subversion \
        freeradius \
        freeradius-mysql \
        libdatetime-perl \
        git \
        curl \
        unzip \
        language-pack-en-base && \
    # Cleanup après apt-get
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# L'image parent s'exécute en root par défaut pour la phase build.
USER root

# Prepare all directories
COPY ./default /etc/nginx/sites-enabled/
RUN mkdir -p /etc/mysql/conf.d
COPY ./disable_strict_mode.cnf /etc/mysql/conf.d/
COPY ./rdcore /var/www/rdcore

RUN mkdir -p /var/www/html
RUN ln -s /var/www/rdcore/rd /var/www/html/rd
RUN ln -s /var/www/rdcore/cake4 /var/www/html/cake4
RUN ln -s /var/www/rdcore/cake4 /var/www/html/cake3
RUN ln -s /var/www/rdcore/login /var/www/html/login
RUN ln -s /var/www/rdcore/AmpConf/build/production/AmpConf /var/www/html/conf_dev
RUN ln -s /var/www/rdcore/login/rd_client/build/production/AmpConf /var/www/html/usage
RUN ln -s /var/www/rdcore/cake4/rd_cake/setup/scripts/reporting /var/www/html/reporting

# Create requried directories
RUN mkdir -p /var/www/html/cake4/rd_cake/logs
RUN mkdir -p /var/www/html/cake4/rd_cake/webroot/files/imagecache
RUN mkdir -p /var/www/html/cake4/rd_cake/tmp

# Set permissions pour l'utilisateur FPM/Nginx (www-data)
RUN chown -R www-data:www-data /var/www/html/cake4/rd_cake/tmp
RUN chown -R www-data:www-data /var/www/html/cake4/rd_cake/logs
RUN chown -R www-data:www-data /var/www/html/cake4/rd_cake/webroot/img/realms
RUN chown -R www-data:www-data /var/www/html/cake4/rd_cake/webroot/img/dynamic_details
RUN chown -R www-data:www-data /var/www/html/cake4/rd_cake/webroot/img/dynamic_photos
RUN chown -R www-data:www-data /var/www/html/cake4/rd_cake/webroot/img/access_providers
RUN chown -R www-data:www-data /var/www/html/cake4/rd_cake/webroot/img/hardwares
RUN chown -R www-data:www-data /var/www/html/cake4/rd_cake/webroot/files/imagecache

# Setup Cron jobs
RUN cp /var/www/rdcore/cake4/rd_cake/setup/cron/cron4 /etc/cron.d/ && \
    chmod 0644 /etc/cron.d/cron4 && \
    /usr/bin/crontab /etc/cron.d/cron4

# configure php-fpm
RUN mkdir -p /var/log/php-fpm /run/php

## configure freeradius
RUN mv /etc/freeradius /etc/freeradius.orig
RUN mkdir -p /etc/freeradius
RUN tar xzf /var/www/rdcore/cake4/rd_cake/setup/radius/freeradius-3-radiusdesk.tar.gz --one-top-level=/etc/freeradius/
RUN mv /etc/freeradius/freeradius /etc/freeradius/3.0
RUN chown -R freerad:freerad /etc/freeradius/3.0/

RUN mkdir -p /var/run/freeradius
RUN chown freerad:freerad /var/run/freeradius

# Configurer FreeRADIUS pour cibler la base MariaDB
RUN sed -i 's/server = \"localhost\"/server = \"rdmariadb\"/g' /etc/freeradius/3.0/mods-available/sql

COPY ./freeradius.service /lib/systemd/system/

# supervisord allows multiple processes to be started with a single process
COPY ./supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Config PHP pour FPM/CLI (chemins Debian)
COPY ./php.ini /etc/php/8.2/fpm/php.ini
COPY ./php.ini /etc/php/8.2/cli/php.ini

# Copy files from production to root www
RUN cp -R /var/www/rdcore/rd/build/production/Rd/* /var/www/html/

# entrypoint run script when container starts - ignores what is in command
ENTRYPOINT ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]

# Only expose radiusdesk web front end to Teaefik and Freeradius UDP ports that bypass traefik
EXPOSE 80/tcp
EXPOSE 1812/udp
EXPOSE 1813/udp
