+        }
+
+        return [
+            'title'      => 'Disconnect Sent',
+            'message'    => "Disconnect completed (ACK {$stats['ack']})",
+            'type'       => 'info',
+            'kick_stats' => $stats,
+            'results'    => $results
+        ];
+    }
