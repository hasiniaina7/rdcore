+            return $default;
+        }
+
+        if($closedCount === $count){
+            $msg = 'Sessions Is already Closed';
+            if($count > 1){
+                $msg = 'Some Sessions Are already Closed';
+            }
+            return ['title' => 'Session Closed Already', 'message' => $msg, 'type' =>'warn'];
+        }
+
+        if(($stats['nak'] + $stats['timeout'] + $stats['stderr']) > 0){
+            return [
+                'title'      => 'Disconnect Partially Failed',
+                'message'    => "ACK {$stats['ack']}, NAK {$stats['nak']}, timeout {$stats['timeout']}, errors {$stats['stderr']}",
+                'type'       => 'warn',
+                'kick_stats' => $stats,
+                'results'    => $results
