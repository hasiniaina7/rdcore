+
+    private function _kickActiveSessionsByUsername($username, $source){
+        $Radaccts = TableRegistry::get('Radaccts');
+        $Users = TableRegistry::get('Users');
+
+        $root_user = $Users->find()->where(['Users.id' => $this->root_user_id])->first();
