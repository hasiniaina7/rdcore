+    private function _loadPositiveEvidenceForNewVouchers(){
+        $conn = ConnectionManager::get('default');
+        $stmt = $conn->execute(
+            "SELECT DISTINCT v.name ".
+            "FROM vouchers v ".
+            "WHERE v.status = 'new' ".
+            "AND (".
+                "v.last_accept_time IS NOT NULL ".
+                "OR EXISTS (SELECT 1 FROM radpostauth p WHERE p.username = v.name AND p.reply = 'Access-Accept') ".
+                "OR EXISTS (SELECT 1 FROM radacct r WHERE r.username = v.name) ".
+                "OR EXISTS (SELECT 1 FROM radacct_history h WHERE h.username = v.name) ".
+                "OR EXISTS (SELECT 1 FROM user_stats u WHERE u.username = v.name)".
+            ")"
+        );
+
+        $positive_evidence = [];
+        while($row = $stmt->fetch('assoc')){
+            $positive_evidence[$row['name']] = true;
+        }
+        return $positive_evidence;
+    }
+
+    protected function _canMarkVoucherUsed($current_status, $has_positive_evidence, $usage){
+        if(in_array($current_status, ['depleted', 'expired'], true)){
+            return false;
+        }
+        if($current_status !== 'new'){
+            return true;
+        }
+        return $has_positive_evidence || (intval($usage) > 0);
+    }
