diff --git a/cake4/rd_cake/src/Controller/Component/KickerComponent.php b/cake4/rd_cake/src/Controller/Component/KickerComponent.php
index e1db94d7..3d9f410a 100644
--- a/cake4/rd_cake/src/Controller/Component/KickerComponent.php
+++ b/cake4/rd_cake/src/Controller/Component/KickerComponent.php
@@ -267,0 +268,99 @@ class KickerComponent extends Component {
+
+    /**
+     * Refresh a FUP rate without performing a generic disconnect. MikroTik
+     * receives its proven host/PPP refresh; non-MikroTik NASes wait for their
+     * next natural authentication rather than risking a captive-portal loop.
+     */
+    public function refreshRate($ent,$token){
+        if(!$ent){
+            return [
+                'strategy' => 'rate-deferred',
+                'status' => 'error',
+                'ack' => false,
+                'stderr' => 'Missing accounting entity',
+                'radacctid' => null,
+            ];
+        }
+
+        if($this->isOmadaNas($ent)){
+            return $this->deferRateRefresh($ent,'omada_rate_deferred');
+        }
+
+        $nasidentifier = $ent->nasidentifier;
+        $nasipaddress = $ent->nasipaddress;
+        $dc = $this->DynamicClients->find()
+            ->where(['DynamicClients.nasidentifier' => $nasidentifier])
+            ->contain(['DynamicClientSettings'])
+            ->first();
+        if($dc){
+            if($this->isOmadaDynamicClient($dc,$ent)){
+                return $this->deferRateRefresh($ent,'omada_rate_deferred');
+            }
+            if($dc->type == $this->typeMtApi){
+                return $this->refreshMikrotikRate($ent,$dc->dynamic_client_settings);
+            }
+        }
+
+        $nas = $this->Nas->find()
+            ->where(['OR' => ['Nas.nasidentifier' => $nasidentifier,'Nas.nasname' => $nasipaddress]])
+            ->contain(['NaSettings'])
+            ->first();
+        if($nas && $nas->type == $this->typeMtApi){
+            return $this->refreshMikrotikRate($ent,$nas->na_settings);
+        }
+
+        return $this->deferRateRefresh($ent,'unsupported_nas_rate_deferred');
+    }
+
+    private function refreshMikrotikRate($ent,$settings){
+        $mtData = $this->mikrotikApiConfig($settings);
+        $refresh = $this->MikrotikApi->refreshRadius($ent,$mtData);
+        return [
+            'strategy' => 'mikrotik-api',
+            'status' => (string)($refresh['status'] ?? 'error'),
+            'ack' => (bool)($refresh['ack'] ?? false),
+            'stderr' => $refresh['error'] ?? null,
+            'radacctid' => $ent->radacctid,
+            'nasidentifier' => $ent->nasidentifier,
+            'nasipaddress' => $ent->nasipaddress,
+            'matched' => (int)($refresh['matched'] ?? 0),
+            'removed' => (int)($refresh['removed'] ?? 0),
+            'mode' => $refresh['mode'] ?? 'rate_refresh',
+        ];
+    }
+
+    private function mikrotikApiConfig($settings){
+        $mtData = [];
+        foreach($settings as $setting){
+            if(preg_match('/^mt_/',$setting->name)){
+                $name = preg_replace('/^mt_/','',$setting->name);
+                $value = $setting->value;
+                if($name == 'port'){
+                    $value = intval($value);
+                }
+                $mtData[$name] = $value;
+            }
+        }
+        if(($mtData['proto'] ?? null) == 'https'){
+            $mtData['ssl'] = true;
+            if(($mtData['port'] ?? null) == 8728){
+                $mtData['port'] = 8729;
+            }
+        }
+        unset($mtData['proto']);
+        return $mtData;
+    }
+
+    private function deferRateRefresh($ent,$mode){
+        return [
+            // This is an acknowledged no-op, not a failed disconnect attempt.
+            'strategy' => 'rate-deferred',
+            'status' => 'ack',
+            'ack' => true,
+            'stderr' => null,
+            'radacctid' => $ent->radacctid,
+            'nasidentifier' => $ent->nasidentifier,
+            'nasipaddress' => $ent->nasipaddress,
+            'mode' => $mode,
+        ];
+    }
diff --git a/cake4/rd_cake/src/Controller/Component/MikrotikApiComponent.php b/cake4/rd_cake/src/Controller/Component/MikrotikApiComponent.php
index 062f8387..73eef108 100644
--- a/cake4/rd_cake/src/Controller/Component/MikrotikApiComponent.php
+++ b/cake4/rd_cake/src/Controller/Component/MikrotikApiComponent.php
@@ -79,0 +80,105 @@ class MikrotikApiComponent extends Component {
+    /**
+     * Re-apply RADIUS rate attributes without using the Hotspot active-session
+     * kick. RouterOS immediately recreates a removed Hotspot host, which makes
+     * the client re-authenticate without returning to the captive portal.
+     */
+    public function refreshRadius($ent,$config){
+	$client 	= new Client($config);
+
+	$called_station_id 	= (string)$ent->calledstationid;
+	$mac_minus			= (string)$ent->callingstationid;
+	$mac_colon			= str_replace('-',':',$mac_minus);
+	$servicetype		= (string)$ent->servicetype;
+	$framedprotocol		= (string)$ent->framedprotocol;
+	$username			= (string)$ent->username;
+
+	if(($servicetype === 'Framed-User') && ($framedprotocol === 'PPP')){
+		return $this->refreshPppRadiusSession($client,$username,$mac_colon);
+	}
+
+	if(preg_match('/^hotspot/',$called_station_id)){
+		return $this->refreshHotspotRadiusSession($client,$mac_colon);
+	}
+
+        return [
+		'status' => 'not_applicable',
+		'ack' => false,
+		'matched' => 0,
+		'removed' => 0,
+		'mode' => 'rate_refresh',
+		'error' => 'unsupported_radius_session_type',
+        ];
+    }
+
+    private function refreshHotspotRadiusSession($client,$macAddress){
+	$active = $this->findRadiusSessions($client,'/ip/hotspot/active/print','mac-address',$macAddress);
+	if(count($active) === 0){
+		return $this->missingRefreshTarget('hotspot_host_refresh','missing_hotspot_active_session');
+	}
+
+	$hosts = $this->findRadiusSessions($client,'/ip/hotspot/host/print','mac-address',$macAddress);
+	if(count($hosts) === 0){
+		return $this->missingRefreshTarget('hotspot_host_refresh','missing_hotspot_host');
+	}
+
+	// Verify only the old IDs: RouterOS can recreate a new host before this call returns.
+	return $this->removeAndVerifyOldIds($client,'/ip/hotspot/host/print','/ip/hotspot/host/remove',$hosts,'hotspot_host_refresh');
+    }
+
+    private function refreshPppRadiusSession($client,$username,$macAddress){
+	$active = $this->findRadiusSessions($client,'/ppp/active/print','name',$username);
+	if($macAddress !== ''){
+		$active = array_values(array_filter($active,function($session) use ($macAddress){
+			return (string)($session['caller-id'] ?? '') === $macAddress;
+		}));
+	}
+	if(count($active) === 0){
+		return $this->missingRefreshTarget('ppp_active_refresh','missing_ppp_active_session');
+	}
+
+	return $this->removeAndVerifyOldIds($client,'/ppp/active/print','/ppp/active/remove',$active,'ppp_active_refresh');
+    }
+
+    private function missingRefreshTarget($mode,$error){
+	return [
+		'status' => 'target_not_found',
+		'ack' => false,
+		'matched' => 0,
+		'removed' => 0,
+		'mode' => $mode,
+		'error' => $error,
+	];
+    }
+
+    private function removeAndVerifyOldIds($client,$listPath,$removePath,$sessions,$mode){
+	$oldIds = [];
+	foreach($sessions as $session){
+		if(!isset($session['.id'])){
+			continue;
+		}
+		$oldIds[] = (string)$session['.id'];
+		$remove = new Query($removePath);
+		$remove->equal('.id',$session['.id']);
+		$client->query($remove)->read();
+	}
+
+	if(count($oldIds) === 0){
+		return $this->missingRefreshTarget($mode,'routeros_target_without_id');
+	}
+
+	// Do not require an empty table: a fresh RouterOS host/session is expected.
+	$remaining = $client->query(new Query($listPath))->read();
+	$remainingOldIds = array_filter($remaining,function($session) use ($oldIds){
+		return isset($session['.id']) && in_array((string)$session['.id'],$oldIds,true);
+	});
+	$ack = count($remainingOldIds) === 0;
+	return [
+		'status' => $ack ? 'ack' : 'target_still_present',
+		'ack' => $ack,
+		'matched' => count($sessions),
+		'removed' => count($oldIds),
+		'mode' => $mode,
+		'error' => $ack ? null : 'routeros_refresh_target_still_present',
+	];
+    }
+
