@@ -0,0 +1,26 @@
+<?php
+declare(strict_types=1);
+
+namespace App\Service;
+
+class OmadaQuotaPolicy
+{
+    /**
+     * FUP groups are generated by RadiusDesk for profiles with dynamic rules.
+     * Their copied counters are policy inputs, never generic terminal quotas.
+     */
+    public static function isFupGroup(string $groupName): bool
+    {
+        return (bool)preg_match('/^FupAdd_[0-9]+$/', $groupName);
+    }
+
+    public static function isHardCap(string $capType, int $cap, int $used): bool
+    {
+        return $capType === 'hard' && $cap > 0 && $used >= $cap;
+    }
+
+    public static function isAcknowledged(array $state): bool
+    {
+        return ($state['last_status'] ?? null) === 'ack';
+    }
+}
