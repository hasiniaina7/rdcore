{
  "name": "portal-backend",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "dotenv -e .env -e ../.env.example -- ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint 'src/**/*.ts' --max-warnings=0",
    "test": "vitest run --config vitest.config.mjs"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "axios-cookiejar-support": "^4.0.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "http-errors": "^2.0.0",
    "lru-cache": "^10.4.3",
    "pino": "^8.21.0",
    "pino-http": "^10.2.0",
    "prom-client": "^15.1.2",
    "swagger-ui-express": "^5.0.1",
    "tough-cookie": "^4.1.4",
    "yaml": "^2.4.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.21",
    "@types/http-errors": "^2.0.4",
    "@types/swagger-ui-express": "^4.1.3",
    "dotenv-cli": "^7.3.0",
    "@types/node": "^20.14.10",
    "@types/supertest": "^2.0.16",
    "@types/tough-cookie": "^4.0.5",
    "supertest": "^7.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
