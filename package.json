{
  "name": "captive-portail",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo Captive Portal (frontend React + backend Node) pour Omada/Radiusdesk",
  "scripts": {
    "bootstrap": "npm install --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start:backend": "npm --workspace backend run start",
    "start:frontend": "npm --workspace frontend run dev",
    "start:infoconso": "npm --workspace infoconso run dev",
    "docs:serve": "redocly preview-docs docs/openapi/openapi.yaml",
    "docs:lint": "spectral lint docs/openapi/openapi.yaml",
    "docs:test": "npm run docs:dredd && npm run docs:newman",
    "docs:dredd": "dredd docs/openapi/openapi.yaml http://localhost:4000 --no-color || true",
    "docs:newman": "openapi2postmanv2 -s docs/openapi/openapi.yaml -o /tmp/postman.json && newman run /tmp/postman.json",
    "docs:bundle": "redocly bundle docs/openapi/openapi.yaml -o docs/openapi/bundle.yaml"
  },
  "workspaces": [
    "backend",
    "frontend",
    "infoconso"
  ],
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "serve": "^14.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techzone-lat/captive-portail.git"
  },
  "author": "Techzone LAT Engineering",
  "license": "MIT",
  "devDependencies": {
    "@redocly/cli": "^1.29.0",
    "@stoplight/spectral-cli": "^6.9.1",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "dredd": "^14.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "newman": "^6.1.3",
    "openapi-to-postmanv2": "^4.21.2",
    "prettier": "^3.3.2",
    "typescript": "^5.4.5"
  }
}
