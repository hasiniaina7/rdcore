{
  "name": "captive-portail",
  "private": true,
  "version": "0.2.0",
  "description": "Monorepo Captive Portal (portal-api + portal-web + usage-dashboard-web)",
  "scripts": {
    "bootstrap": "npm install --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start:backend": "npm --workspace apps/backend-portal-api-rd-omada run start",
    "start:frontend": "npm --workspace apps/frontend-portal-web-personalized run dev --",
    "start:infoconso": "npm --workspace apps/frontend-infoconso-rd run dev --",
    "docs:serve": "redocly preview-docs docs/api/openapi.yaml",
    "docs:lint": "spectral lint docs/api/openapi.yaml",
    "docs:test": "npm run docs:dredd && npm run docs:newman",
    "docs:dredd": "dredd docs/api/openapi.yaml http://localhost:4000 --no-color || true",
    "docs:newman": "openapi2postmanv2 -s docs/api/openapi.yaml -o /tmp/postman.json && newman run /tmp/postman.json",
    "docs:bundle": "redocly bundle docs/api/openapi.yaml -o docs/api/bundle.yaml",
    "validate:structure": "node deployments/scripts/validate_structure.mjs"
  },
  "workspaces": [
    "apps/backend-portal-api-rd-omada",
    "apps/frontend-portal-web-personalized",
    "apps/frontend-infoconso-rd"
  ],
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "serve": "^14.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techzone-lat/captive-portail.git"
  },
  "author": "Techzone LAT Engineering",
  "license": "MIT",
  "devDependencies": {
    "@redocly/cli": "^1.29.0",
    "@stoplight/spectral-cli": "^6.9.1",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "dredd": "^14.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "newman": "^6.1.3",
    "openapi-to-postmanv2": "^4.21.2",
    "prettier": "^3.3.2",
    "typescript": "^5.4.5"
  }
}
